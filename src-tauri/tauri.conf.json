{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "GeoReport",
    "mainBinaryName": "GeoReport",
    "version": "1.0.0",
    "identifier": "ph.gov.loon.georeport",
    "build": {
        "frontendDist": "../desktop"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "GeoReport — Municipality of Loon, Province of Bohol",
                "width": 1280,
                "height": 820,
                "minWidth": 360,
                "minHeight": 600,
                "resizable": true,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ]
    }
}
